[Unit]
Description=vLLM OpenAI Server (Qwen 72B AWQ)
After=network.target

[Service]
Type=simple
User=omm22003
Group=domain users
WorkingDirectory=/home/omm22003/distillation
Environment=HF_HOME=/home/omm22003/.cache/huggingface
Environment=TRANSFORMERS_CACHE=/home/omm22003/.cache/huggingface
ExecStart=/home/omm22003/distillation/.venv_webapp/bin/python -m vllm.entrypoints.openai.api_server --host 127.0.0.1 --port 8004 --model Qwen/Qwen2.5-72B-Instruct-AWQ --quantization awq_marlin --dtype float16 --gpu-memory-utilization 0.92 --served-model-name qwen-72b-vllm
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
